{
  "$description": "Tokens del sistema de diseño CodeLibri. Es la fuente: de aquí salen la hoja, los tokens resueltos para Figma y la documentación. Una referencia entre llaves —{paleta.primary.500}— apunta a otro token.",
  "nombre": "Sistema de diseño CodeLibri",
  "version": "0.2.0",

  "paleta": {
    "$description": "La del Figma de CodeLibri (Design System → Paleta de Color), leída muestra por muestra el 20 de septiembre de 2026. Es la misma en los dos temas.",
    "primary":    { "50": "#f0eefe", "100": "#d1cafc", "200": "#bbb1fb", "300": "#9d8df9", "400": "#8977f8", "500": "#6c55f6", "600": "#624de0", "700": "#4d3caf", "800": "#3b2f87", "900": "#2d2467" },
    "secondary":  { "50": "#e8fdfa", "100": "#b6faef", "200": "#93f7e7", "300": "#62f4db", "400": "#44f1d5", "500": "#15eeca", "600": "#13d9b8", "700": "#0fa98f", "800": "#0c836f", "900": "#096455" },
    "secondary2": { "50": "#ffecf4", "100": "#ffc5db", "200": "#ffa9ca", "300": "#ff82b2", "400": "#ff69a3", "500": "#ff448c", "600": "#e83e7f", "700": "#b53063", "800": "#8c254d", "900": "#6b1d3b" },
    "success":    { "50": "#e9fcf3", "100": "#bcf4da", "200": "#9cefc8", "300": "#6ee8af", "400": "#52e49f", "500": "#27dd87", "600": "#23c97b", "700": "#1c9d60", "800": "#157a4a", "900": "#105d39" },
    "warning":    { "50": "#fff9e6", "100": "#ffebb0", "200": "#ffe28a", "300": "#ffd454", "400": "#ffcc33", "500": "#ffbf00", "600": "#e8ae00", "700": "#b58800", "800": "#8c6900", "900": "#6b5000" },
    "danger":     { "50": "#fef0ee", "100": "#fcd1cb", "200": "#fabab1", "300": "#f89b8e", "400": "#f78878", "500": "#f56a56", "600": "#df604e", "700": "#ae4b3d", "800": "#873a2f", "900": "#672d24" },
    "info":       { "50": "#f0f4ff", "100": "#cfddfe", "200": "#b8ccfe", "300": "#97b5fe", "400": "#83a6fd", "500": "#6490fd", "600": "#5b83e6", "700": "#4766b4", "800": "#374f8b", "900": "#2a3c6a" },
    "text":       { "50": "#eaeaeb", "100": "#bfbfc0", "200": "#a09fa2", "300": "#747478", "400": "#59595d", "500": "#302f35", "600": "#2c2b30", "700": "#222126", "800": "#1a1a1d", "900": "#141416" },
    "white":      { "500": "#ffffff", "600": "#e8e8e8", "700": "#b5b5b5", "800": "#8c8c8c", "900": "#6b6b6b" },
    "black":      { "50": "#e6e6e6", "100": "#b0b0b0", "200": "#8a8a8a", "300": "#545454", "400": "#333333", "500": "#000000" }
  },

  "degradado": {
    "$description": "Los tres de la casa, con los colores en su paso 500. Decisión de Luis del 15 de septiembre de 2026, tomada con las cifras delante: el texto blanco queda en 1.49:1 sobre el extremo menta y en 3.25:1 sobre el rosa. Está medido y aceptado; no se corrige.",
    "marca":    { "$value": ["{paleta.secondary.500}", "{paleta.primary.500}", "{paleta.secondary2.500}"], "$description": "El nombre de la marca en un titular." },
    "explorar": { "$value": ["{paleta.primary.500}", "{paleta.secondary.500}"], "$description": "El botón principal." },
    "apoyo":    { "$value": ["{paleta.primary.500}", "{paleta.secondary2.500}"], "$description": "Apoyar, donar: la invitación." }
  },

  "familia": {
    "$description": "Las tres familias de la marca. Cada producto elige una como acento; una pieza suelta puede llevar otra con la clase cl-f-<familia>. El paso de texto es el más claro que da 4.5:1 sobre el peor fondo de cada tema (blanco, lienzo, fondo suave y paso 50).",
    "primary":    { "texto-claro": "{paleta.primary.600}",    "texto-oscuro": "{paleta.primary.300}",    "sobre": "#ffffff" },
    "secondary":  { "texto-claro": "{paleta.secondary.900}",  "texto-oscuro": "{paleta.secondary.400}",  "sobre": "{paleta.text.900}" },
    "secondary2": { "texto-claro": "{paleta.secondary2.700}", "texto-oscuro": "{paleta.secondary2.300}", "sobre": "{paleta.text.900}" }
  },

  "estado": {
    "$description": "Los avisos. Mismo criterio que las familias: el texto es el paso más claro que llega a 4.5:1.",
    "exito":       { "familia": "success", "texto-claro": "{paleta.success.800}", "texto-oscuro": "{paleta.success.300}" },
    "advertencia": { "familia": "warning", "texto-claro": "{paleta.warning.800}", "texto-oscuro": "{paleta.warning.300}" },
    "error":       { "familia": "danger",  "texto-claro": "{paleta.danger.700}",  "texto-oscuro": "{paleta.danger.300}" },
    "info":        { "familia": "info",    "texto-claro": "{paleta.info.700}",    "texto-oscuro": "{paleta.info.300}" }
  },

  "tema": {
    "$description": "Los tokens de uso. Cambian con el tema; los componentes solo usan estos, nunca la paleta directa.",
    "claro": {
      "fondo":            { "$value": "#fafbfc", "$description": "El lienzo: casi blanco." },
      "superficie":       { "$value": "#ffffff", "$description": "Tarjetas, fichas, menús." },
      "superficie-linea": "rgba(20,20,22,.07)",
      "vidrio":           { "$value": "rgba(255,255,255,.75)", "$description": "Solo las dos barras del armazón." },
      "vidrio-linea":     "rgba(255,255,255,.6)",
      "linea":            { "$value": "rgba(20,20,22,.08)", "$description": "Filetes y bordes de controles." },
      "linea-2":          { "$value": "rgba(20,20,22,.16)", "$description": "El filete al pasar por encima." },
      "campo":            { "$value": "rgba(244,245,247,.7)", "$description": "Fondo de los campos de texto." },
      "flotar":           { "$value": "rgba(20,20,22,.04)", "$description": "Fondo al pasar por encima de un elemento de lista." },
      "texto":            "{paleta.text.900}",
      "texto-2":          "{paleta.text.400}",
      "texto-3":          { "$value": "{paleta.text.300}", "$description": "4.65:1 sobre blanco: solo sobre superficie. Suelto sobre el lienzo, texto-2." },
      "acento":           "{acento.texto-claro}",
      "acento-solido":    "{acento.500}",
      "acento-suave":     "color-mix(in srgb, {acento.500} 10%, transparent)",
      "acento-linea":     "color-mix(in srgb, {acento.500} 22%, transparent)",
      "acento-sobre":     "{acento.sobre}",
      "foco":             "color-mix(in srgb, {acento.500} 30%, transparent)",
      "sombra-1":         { "$value": "0 1px 2px rgba(20,20,22,.05)", "$description": "La de reposo: controles y tarjetas." },
      "sombra-2":         { "$value": "0 12px 24px -8px rgba(108,85,246,.16)", "$description": "Tarjeta al pasar por encima." },
      "sombra-3":         { "$value": "0 18px 40px -14px rgba(20,20,22,.22)", "$description": "Menús, ventanas y avisos flotantes." },
      "sombra-marca":     { "$value": "0 4px 14px rgba(108,85,246,.39)", "$description": "Botones con degradado." },
      "sombra-marca-2":   "0 6px 20px rgba(108,85,246,.5)",
      "mancha-1":         "rgba(108,85,246,.07)",
      "mancha-2":         "rgba(21,238,202,.07)",
      "riel":             "#eef0f3",
      "perilla":          "#fdb813",
      "velo":             { "$value": "rgba(20,20,22,.35)", "$description": "Detrás del cajón de navegación." },
      "velo-modal":       "rgba(14,10,32,.5)",
      "barra":            { "$value": "rgba(20,20,22,.1)", "$description": "Barras de desplazamiento." },
      "barra-viva":       "rgba(20,20,22,.2)",
      "f-primary-fondo":     "{paleta.primary.50}",
      "f-primary-linea":     "{paleta.primary.100}",
      "f-primary-texto":     "{familia.primary.texto-claro}",
      "f-secondary-fondo":   "{paleta.secondary.50}",
      "f-secondary-linea":   "{paleta.secondary.100}",
      "f-secondary-texto":   "{familia.secondary.texto-claro}",
      "f-secondary2-fondo":  "{paleta.secondary2.50}",
      "f-secondary2-linea":  "{paleta.secondary2.100}",
      "f-secondary2-texto":  "{familia.secondary2.texto-claro}",
      "exito-fondo":         "{paleta.success.50}",
      "exito-linea":         "color-mix(in srgb, {paleta.success.700} 28%, transparent)",
      "exito-texto":         "{estado.exito.texto-claro}",
      "advertencia-fondo":   "{paleta.warning.50}",
      "advertencia-linea":   "color-mix(in srgb, {paleta.warning.700} 30%, transparent)",
      "advertencia-texto":   "{estado.advertencia.texto-claro}",
      "error-fondo":         "{paleta.danger.50}",
      "error-linea":         "color-mix(in srgb, {paleta.danger.700} 28%, transparent)",
      "error-texto":         "{estado.error.texto-claro}",
      "info-fondo":          "{paleta.info.50}",
      "info-linea":          "color-mix(in srgb, {paleta.info.700} 28%, transparent)",
      "info-texto":          "{estado.info.texto-claro}"
    },
    "oscuro": {
      "fondo":            "{paleta.text.900}",
      "superficie":       "{paleta.text.700}",
      "superficie-linea": "rgba(255,255,255,.07)",
      "vidrio":           "rgba(26,26,29,.74)",
      "vidrio-linea":     "rgba(255,255,255,.06)",
      "linea":            "rgba(255,255,255,.08)",
      "linea-2":          "rgba(255,255,255,.18)",
      "campo":            "rgba(255,255,255,.05)",
      "flotar":           "rgba(255,255,255,.05)",
      "texto":            "{paleta.text.50}",
      "texto-2":          "{paleta.text.100}",
      "texto-3":          "{paleta.text.200}",
      "acento":           "{acento.texto-oscuro}",
      "acento-solido":    "{acento.500}",
      "acento-suave":     "color-mix(in srgb, {acento.500} 16%, transparent)",
      "acento-linea":     "color-mix(in srgb, {acento.500} 32%, transparent)",
      "acento-sobre":     "{acento.sobre}",
      "foco":             "color-mix(in srgb, {acento.400} 45%, transparent)",
      "sombra-1":         "0 1px 2px rgba(0,0,0,.4)",
      "sombra-2":         "0 14px 30px -10px rgba(0,0,0,.7)",
      "sombra-3":         "0 18px 40px -14px rgba(0,0,0,.8)",
      "sombra-marca":     "0 4px 14px rgba(108,85,246,.39)",
      "sombra-marca-2":   "0 6px 20px rgba(108,85,246,.5)",
      "mancha-1":         "rgba(108,85,246,.16)",
      "mancha-2":         "rgba(21,238,202,.07)",
      "riel":             "{paleta.text.600}",
      "perilla":          "{paleta.primary.200}",
      "velo":             "rgba(0,0,0,.55)",
      "velo-modal":       "rgba(0,0,0,.6)",
      "barra":            "rgba(255,255,255,.1)",
      "barra-viva":       "rgba(255,255,255,.2)",
      "f-primary-fondo":     "rgba(108,85,246,.18)",
      "f-primary-linea":     "transparent",
      "f-primary-texto":     "{familia.primary.texto-oscuro}",
      "f-secondary-fondo":   "rgba(21,238,202,.12)",
      "f-secondary-linea":   "transparent",
      "f-secondary-texto":   "{familia.secondary.texto-oscuro}",
      "f-secondary2-fondo":  "rgba(255,68,140,.14)",
      "f-secondary2-linea":  "transparent",
      "f-secondary2-texto":  "{familia.secondary2.texto-oscuro}",
      "exito-fondo":         "rgba(39,221,135,.1)",
      "exito-linea":         "rgba(39,221,135,.25)",
      "exito-texto":         "{estado.exito.texto-oscuro}",
      "advertencia-fondo":   "rgba(255,191,0,.1)",
      "advertencia-linea":   "rgba(255,191,0,.28)",
      "advertencia-texto":   "{estado.advertencia.texto-oscuro}",
      "error-fondo":         "rgba(245,106,86,.12)",
      "error-linea":         "rgba(245,106,86,.3)",
      "error-texto":         "{estado.error.texto-oscuro}",
      "info-fondo":          "rgba(100,144,253,.12)",
      "info-linea":          "rgba(100,144,253,.3)",
      "info-texto":          "{estado.info.texto-oscuro}"
    }
  },

  "tipo": {
    "$description": "Inter, variable del 400 al 800, servida desde el propio dominio. Los tamaños son los del Aula.",
    "fuente":      "\"Inter\", \"Segoe UI\", system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif",
    "fuente-mono": "ui-monospace, \"Cascadia Code\", Consolas, \"SFMono-Regular\", monospace",
    "tamano": {
      "display":    { "$value": "clamp(38px, 4.2vw, 54px)", "$description": "El titular de una portada." },
      "titulo":     { "$value": "clamp(24px, 2.4vw, 32px)", "$description": "El título de una página interior." },
      "encabezado": { "$value": "26px", "$description": "El título de una ficha o de una caja." },
      "seccion":    { "$value": "20px", "$description": "El título de una sección o de una ventana." },
      "subseccion": { "$value": "17px", "$description": "Subtítulos y la entrada de una portada." },
      "tarjeta":    { "$value": "16.5px", "$description": "El título dentro de una tarjeta." },
      "cuerpo":     { "$value": "15px", "$description": "Texto de lectura." },
      "ui":         { "$value": "14px", "$description": "Controles, navegación, texto de interfaz." },
      "chico":      { "$value": "13.5px", "$description": "Resúmenes de tarjeta y notas." },
      "nota":       { "$value": "13px", "$description": "Metadatos, pies, ayudas." },
      "mini":       { "$value": "12.5px", "$description": "Aclaraciones bajo un campo, código." },
      "micro":      "12px",
      "rotulo":     { "$value": "11px", "$description": "Rótulos de grupo en mayúsculas." },
      "etiqueta":   { "$value": "10px", "$description": "Etiquetas e insignias en mayúsculas." }
    },
    "peso": { "normal": "400", "medio": "500", "semi": "600", "negrita": "700", "extra": "800" },
    "interlineado": { "apretado": "1.05", "titulo": "1.2", "compacto": "1.35", "normal": "1.55", "holgado": "1.65" },
    "tracking": { "display": "-.035em", "titulo": "-.03em", "seccion": "-.02em", "tarjeta": "-.01em", "rotulo": ".1em" }
  },

  "espacio": {
    "$description": "Múltiplos de 4. Entre secciones de una página, 52; dentro de una tarjeta, 16 a 20.",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "7": "32px", "8": "40px", "9": "52px", "10": "64px"
  },

  "radio": {
    "$description": "Seis en etiquetas, ocho en controles, doce en menús y cajas pequeñas, dieciséis en tarjetas y ventanas.",
    "chico": "6px", "control": "8px", "medio": "12px", "grande": "16px", "pildora": "999px"
  },

  "movimiento": {
    "rapido": ".15s", "medio": ".2s", "lento": ".3s",
    "curva": "ease", "curva-salida": "cubic-bezier(.3,.7,.3,1)"
  },

  "capa": {
    "superior": "40", "velo": "45", "lateral": "50", "modal": "100", "aviso": "120", "saltar": "200"
  },

  "armazon": {
    "$description": "Medidas del armazón. La barra lateral mide 290 y no 280: con la ventana baja su barra de desplazamiento se come ese ancho.",
    "lateral": "290px", "lateral-plegada": "76px", "alto-superior": "72px", "alto-superior-estrecho": "60px"
  }
}
